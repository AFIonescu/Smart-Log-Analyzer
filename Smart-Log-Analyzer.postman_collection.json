    {
      "name": "Log Ingestion Tests",
      "item": [
        {
          "name": "Test 2.1: Create New Log Entry",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains _id\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('_id');",
                  "    pm.environment.set('log_id', jsonData._id);",
                  "});",
                  "",
                  "pm.test(\"NLP analysis is present\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('nlp_analysis');",
                  "    pm.expect(jsonData.nlp_analysis).to.have.property('sentiment');",
                  "    pm.expect(jsonData.nlp_analysis).to.have.property('keywords');",
                  "});",
                  "",
                  "pm.test(\"Category is assigned\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('category');",
                  "});",
                  "",
                  "pm.test(\"Severity score is calculated\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('severity_score');",
                  "    pm.expect(jsonData.severity_score).to.be.a('number');",
                  "    pm.expect(jsonData.severity_score).to.be.within(0, 10);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"level\": \"ERROR\",\n  \"source\": \"payment-service\",\n  \"message\": \"Payment processing failed for user 12345 - connection timeout\",\n  \"metadata\": {\n    \"user_id\": \"12345\",\n    \"transaction_id\": \"txn_98765\"\n  }\n}"
            },
            "url": {
